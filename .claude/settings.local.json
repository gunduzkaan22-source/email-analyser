  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$raw = [Console]::In.ReadToEnd(); $j = $raw | ConvertFrom-Json; $f = $j.tool_input.file_path; if ($f -and $f.EndsWith('.py')) { $err = python -m py_compile $f 2>&1; if ($LASTEXITCODE -ne 0) { $ctx = 'Syntax error in ' + $f + ': ' + ($err -join '; '); ConvertTo-Json -Compress @{hookSpecificOutput=@{hookEventName='PostToolUse';additionalContext=$ctx}} } }; exit 0",
            "shell": "powershell",
            "statusMessage": "Checking Python syntax..."
          }
        ]
      }
    ]
